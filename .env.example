# Copy to .env (cp .env.example .env) and adjust if needed.
# Host ports
APP_PORT=8000
GO_PORT=8080

# Laravel
APP_ENV=production
APP_DEBUG=false
# Use your public URL on a VPS, e.g. http://YOUR_SERVER_IP:8000
APP_URL=http://localhost:8000
# Optional: leave empty to auto-generate (persisted in the data volume).
# Or generate one: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
